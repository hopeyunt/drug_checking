# ─────────────────────────────────────────────────────────
# DrugCheck — переменные окружения
# Скопируй файл: cp .env.example .env
# Затем заполни значения и запусти: docker-compose up -d
# ─────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=drugcheck
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_prod
DATABASE_URL=postgresql://postgres:changeme_in_prod@postgres:5432/drugcheck

# Redis
REDIS_URL=redis://redis:6379/0

# JWT — сгенерируй случайный ключ:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Биллинг
CHECK_COST=5
WELCOME_BONUS=50

# Путь к обученной ML-модели (внутри контейнера, менять не нужно)
MODEL_PATH=/ml/interaction_model.joblib

# Grafana
GRAFANA_PASSWORD=admin

# ГРЛС API (опционально — оставь пустым для работы с локальной базой)
GRLS_API_KEY=

# ЮКасса (платёжный шлюз)
# Получить ключи: https://yookassa.ru → Настройки → API-ключи
# Без ключей сервис работает в тестовом режиме (кредиты начисляются без оплаты)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:8501
